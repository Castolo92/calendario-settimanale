@page "/attivita"
@inject CalendarioService Svc
@inject IJSRuntime JS
@inject Sessione Sessione

<PageTitle>Attività</PageTitle>

<div class="pagina-stretta">
    <div class="titolo-pagina">
        <h1>Attività</h1>
        @if (bozza is null)
        {
            <div class="azioni-titolo">
                <label class="btn btn-secondario file-btn" title="Scegli più immagini: ognuna diventa un'attività con il nome del file">
                    🖼️ Importa immagini
                    <InputFile OnChange="Importa" accept="image/*" multiple disabled="@(importazione is not null)" />
                </label>
                <button class="btn btn-primario" @onclick="Nuova">+ Nuova attività</button>
            </div>
        }
    </div>

    @if (bozza is not null)
    {
        <div class="card form-attivita">
            <h2>@(bozza.Id == 0 ? "Nuova attività" : "Modifica attività")</h2>
            <EditForm Model="bozza" OnValidSubmit="Salva">
                <DataAnnotationsValidator />

                <div class="form-riga">
                    <div class="anteprima" style="--colore:@bozza.Colore">
                        @if (anteprima is not null)
                        {
                            <img src="@anteprima" alt="" />
                        }
                        else
                        {
                            <span class="anteprima-vuota">🖼️</span>
                        }
                    </div>
                    <div class="form-campi">
                        <label class="campo">
                            <span>Nome</span>
                            <InputText @bind-Value="bozza.Nome" class="input" placeholder="Es. Palestra" />
                            <ValidationMessage For="() => bozza.Nome" />
                        </label>
                        <label class="campo campo-colore">
                            <span>Colore</span>
                            <input type="color" @bind="bozza.Colore" class="input-colore" />
                        </label>
                    </div>
                </div>

                <div class="campo">
                    <span>Immagine</span>
                    <label class="btn btn-secondario file-btn">
                        📷 Scegli immagine
                        <InputFile OnChange="CaricaImmagine" accept="image/*" />
                    </label>
                    @if (anteprima is not null)
                    {
                        <button type="button" class="btn btn-link" @onclick="RimuoviImmagine">Rimuovi immagine</button>
                    }
                    @if (caricamento)
                    {
                        <span class="nota">Elaborazione immagine…</span>
                    }
                    @if (errore is not null)
                    {
                        <div class="errore">@errore</div>
                    }
                </div>

                <div class="azioni">
                    <button type="submit" class="btn btn-primario" disabled="@(caricamento || salvataggio)">@(salvataggio ? "Salvataggio…" : "Salva")</button>
                    <button type="button" class="btn btn-secondario" @onclick="Annulla">Annulla</button>
                </div>
            </EditForm>
        </div>
    }

    @if (importazione is not null)
    {
        <div class="card importazione">⏳ @importazione</div>
    }

    @if (erroreElenco is not null)
    {
        <div class="avviso">⚠️ @erroreElenco</div>
    }

    @if (elenco is null)
    {
        <p class="nota">Caricamento…</p>
    }
    else if (elenco.Count == 0)
    {
        <div class="vuoto">Nessuna attività ancora. Creane una con <b>+ Nuova attività</b>.</div>
    }
    else
    {
        <ul class="lista-attivita">
            @foreach (var a in elenco)
            {
                <li class="card riga-attivita" style="--colore:@a.Colore">
                    <div class="miniatura">
                        @if (a.UrlImmagine is not null)
                        {
                            <img src="@a.UrlImmagine" alt="" loading="lazy" />
                        }
                    </div>
                    <span class="nome">@a.Nome</span>
                    <button class="btn btn-icona" title="Modifica" @onclick="() => Modifica(a)">✏️</button>
                    <button class="btn btn-icona" title="Elimina" @onclick="() => Elimina(a)">🗑️</button>
                </li>
            }
        </ul>
    }
    <div class="azioni azioni-fondo">
        <span class="nota">Collegato come @Sessione.Email</span>
        <button class="btn btn-link" @onclick="Esci">Esci</button>
    </div>
</div>

@code {
    private List<Attivita>? elenco;
    private Attivita? bozza;
    private string? anteprima;
    private byte[]? nuovaImmagine;
    private string? nuovoContentType;
    private bool rimuovi;
    private bool caricamento;
    private string? errore;
    private string? erroreElenco;
    private bool salvataggio;
    private string? importazione;

    private const int LatoMax = 800;
    private const long DimensioneMax = 15 * 1024 * 1024;

    protected override async Task OnInitializedAsync() => await Ricarica();

    private async Task Ricarica()
    {
        try
        {
            elenco = await Svc.GetAttivitaAsync();
            erroreElenco = null;
        }
        catch (ErroreSupabase ex)
        {
            elenco ??= [];
            erroreElenco = ex.Message;
        }
    }

    private void Nuova() => Apri(new Attivita());

    private void Modifica(Attivita a) => Apri(a.Copia());

    private void Apri(Attivita a)
    {
        bozza = a;
        anteprima = a.UrlImmagine;
        nuovaImmagine = null;
        nuovoContentType = null;
        rimuovi = false;
        errore = null;
    }

    private void Annulla() => bozza = null;

    private async Task CaricaImmagine(InputFileChangeEventArgs e)
    {
        errore = null;
        var file = e.File;
        if (!file.ContentType.StartsWith("image/"))
        {
            errore = "Il file selezionato non è un'immagine.";
            return;
        }

        caricamento = true;
        try
        {
            // PNG/WebP mantengono la trasparenza, il resto diventa JPEG.
            // Il ridimensionamento avviene nel browser: anche le foto grandi del telefono vanno bene.
            (nuovaImmagine, nuovoContentType) = await RiduciAsync(file);
            var formato = nuovoContentType;
            rimuovi = false;
            anteprima = $"data:{formato};base64,{Convert.ToBase64String(nuovaImmagine)}";
        }
        catch (Exception ex)
        {
            errore = "Impossibile leggere l'immagine: " + ex.Message;
        }
        finally
        {
            caricamento = false;
        }
    }

    /// <summary>Ridimensiona l'immagine nel browser (max 800 px) e la restituisce con il suo formato.</summary>
    private static async Task<(byte[] Dati, string ContentType)> RiduciAsync(IBrowserFile file)
    {
        var formato = file.ContentType switch
        {
            "image/png" or "image/gif" or "image/svg+xml" => "image/png",
            "image/webp" => "image/webp",
            _ => "image/jpeg"
        };
        var ridotta = await file.RequestImageFileAsync(formato, LatoMax, LatoMax);
        await using var stream = ridotta.OpenReadStream(DimensioneMax);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        return (ms.ToArray(), formato);
    }

    private static readonly string[] Colori = ["#ff5a5f", "#ff9f1c", "#f7c600", "#2ec27e", "#3a86ff", "#8f5cff", "#ff5fa2"];

    /// <summary>Crea un'attività per ogni immagine scelta, usando il nome del file come nome dell'attività.</summary>
    private async Task Importa(InputFileChangeEventArgs e)
    {
        var files = e.GetMultipleFiles(60).Where(f => f.ContentType.StartsWith("image/")).ToList();
        if (files.Count == 0) return;

        erroreElenco = null;
        var errori = new List<string>();
        for (int i = 0; i < files.Count; i++)
        {
            var file = files[i];
            var nome = NomeDaFile(file.Name);
            importazione = $"Importo {i + 1} di {files.Count}: {nome}";
            StateHasChanged();
            try
            {
                var (dati, tipo) = await RiduciAsync(file);
                await Svc.SalvaAttivitaAsync(new Attivita { Nome = nome, Colore = Colori[i % Colori.Length] }, dati, tipo, false);
            }
            catch (Exception ex) when (ex is ErroreSupabase or IOException or InvalidOperationException or JSException)
            {
                errori.Add($"{nome}: {ex.Message}");
            }
        }
        importazione = null;
        await Ricarica();
        if (errori.Count > 0) erroreElenco = "Alcune immagini non sono state importate. " + string.Join(" · ", errori);
    }

    /// <summary>"03 - Parco_giochi.jpg" diventa "Parco giochi".</summary>
    private static string NomeDaFile(string nomeFile)
    {
        var nome = Path.GetFileNameWithoutExtension(nomeFile).Replace('_', ' ').Trim();
        nome = System.Text.RegularExpressions.Regex.Replace(nome, @"^\d+\s*[-.)]?\s*", "");
        if (nome.Length == 0) nome = "Attività";
        return nome.Length > 80 ? nome[..80] : nome;
    }

    private void RimuoviImmagine()
    {
        anteprima = null;
        nuovaImmagine = null;
        nuovoContentType = null;
        rimuovi = true;
    }

    private async Task Salva()
    {
        if (bozza is null || salvataggio) return;
        salvataggio = true;
        errore = null;
        try
        {
            await Svc.SalvaAttivitaAsync(bozza, nuovaImmagine, nuovoContentType, rimuovi);
            bozza = null;
            await Ricarica();
        }
        catch (ErroreSupabase ex)
        {
            errore = ex.Message;
        }
        finally
        {
            salvataggio = false;
        }
    }

    private async Task Elimina(Attivita a)
    {
        var ok = await JS.InvokeAsync<bool>("confirm",
            $"Eliminare l'attività \"{a.Nome}\"? Verrà tolta anche dal calendario.");
        if (!ok) return;
        try
        {
            await Svc.EliminaAttivitaAsync(a);
            if (bozza?.Id == a.Id) bozza = null;
        }
        catch (ErroreSupabase ex)
        {
            erroreElenco = ex.Message;
        }
        await Ricarica();
    }

    private async Task Esci()
    {
        if (await JS.InvokeAsync<bool>("confirm", "Uscire da questo dispositivo? Per rientrare serviranno email e password."))
            await Sessione.EsciAsync();
    }
}
