@page "/pianifica"
@inject CalendarioService Svc
@inject IJSRuntime JS

<PageTitle>Pianifica</PageTitle>

<div class="pagina-stretta">
    <div class="nav-settimana compatta">
        <button class="btn btn-icona" @onclick="() => CambiaSettimana(-7)" aria-label="Settimana precedente">‹</button>
        <div class="etichetta-settimana">@Formati.Settimana(inizio)</div>
        <button class="btn btn-icona" @onclick="() => CambiaSettimana(7)" aria-label="Settimana successiva">›</button>
    </div>

    <div class="giorni-chip">
        @for (int i = 0; i < 7; i++)
        {
            var g = inizio.AddDays(i);
            var pieni = PeriodoInfo.Tutti.Count(p => mappa.ContainsKey((g, p)));
            <button class="chip giorno-@i @(g == giorno ? "attivo" : "") @(g == CalendarioService.Oggi ? "oggi" : "")"
                    @onclick="() => giorno = g">
                <span class="chip-giorno">@g.ToString("ddd")</span>
                <span class="chip-numero">@g.Day</span>
                <span class="chip-punti">
                    @for (int k = 0; k < 4; k++)
                    {
                        <i class="@(k < pieni ? "pieno" : "")"></i>
                    }
                </span>
            </button>
        }
    </div>

    <h1 class="giorno-titolo giorno-@(giorno.DayNumber - inizio.DayNumber)">@giorno.ToString("dddd d MMMM")</h1>

    @if (attivita is null)
    {
        <p class="nota">Caricamento…</p>
    }
    else if (attivita.Count == 0)
    {
        <div class="vuoto">
            Non ci sono ancora attività. <a href="attivita">Creale nella pagina Attività</a> e poi torna qui.
        </div>
    }
    else
    {
        @foreach (var periodo in PeriodoInfo.Tutti)
        {
            var scelta = mappa.TryGetValue((giorno, periodo), out var id) ? id : (long?)null;
            <section class="card slot periodo-@((int)periodo)">
                <h2>@PeriodoInfo.Icona(periodo) @periodo</h2>
                <div class="scelte">
                    <button class="scelta nessuna @(scelta is null ? "selezionata" : "")"
                            @onclick="() => Imposta(periodo, null)">
                        <span class="scelta-img">✕</span>
                        <span class="scelta-nome">Nessuna</span>
                    </button>
                    @foreach (var a in attivita)
                    {
                        <button class="scelta @(scelta == a.Id ? "selezionata" : "")" style="--colore:@a.Colore"
                                @onclick="() => Imposta(periodo, a.Id)">
                            <span class="scelta-img">
                                @if (a.UrlImmagine is not null)
                                {
                                    <img src="@a.UrlImmagine" alt="" loading="lazy" />
                                }
                                else
                                {
                                    @a.Nome[..1]
                                }
                            </span>
                            <span class="scelta-nome">@a.Nome</span>
                        </button>
                    }
                </div>
            </section>
        }

        <div class="azioni azioni-fondo">
            <button class="btn btn-secondario" @onclick="CopiaPrecedente">⧉ Copia settimana precedente</button>
        </div>
    }
</div>

@if (messaggio is not null)
{
    <div class="toast @(messaggioErrore ? "toast-errore" : "")" @key="messaggioId">@messaggio</div>
}

@code {
    private DateOnly inizio = CalendarioService.InizioSettimana(CalendarioService.Oggi);
    private DateOnly giorno = CalendarioService.Oggi;
    private Dictionary<(DateOnly, Periodo), long> mappa = [];
    private List<Attivita>? attivita;
    private string? messaggio;
    private bool messaggioErrore;
    private int messaggioId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            attivita = await Svc.GetAttivitaAsync();
            mappa = await Svc.GetSettimanaAsync(inizio);
        }
        catch (ErroreSupabase ex)
        {
            attivita = [];
            await MostraMessaggio(ex.Message, true);
        }
    }

    private async Task CambiaSettimana(int giorni)
    {
        inizio = inizio.AddDays(giorni);
        giorno = giorno.AddDays(giorni);
        try
        {
            mappa = await Svc.GetSettimanaAsync(inizio);
        }
        catch (ErroreSupabase ex)
        {
            mappa = [];
            await MostraMessaggio(ex.Message, true);
        }
    }

    private async Task Imposta(Periodo periodo, long? attivitaId)
    {
        var chiave = (giorno, periodo);
        var precedente = mappa.TryGetValue(chiave, out var v) ? v : (long?)null;
        if (precedente == attivitaId) return;

        // Aggiorna subito lo schermo, poi salva; se il salvataggio fallisce torna com'era
        Applica(chiave, attivitaId);
        try
        {
            await Svc.ImpostaAsync(giorno, periodo, attivitaId);
            await MostraMessaggio("Salvato ✓");
        }
        catch (ErroreSupabase ex)
        {
            Applica(chiave, precedente);
            await MostraMessaggio(ex.Message, true);
        }
    }

    private void Applica((DateOnly, Periodo) chiave, long? attivitaId)
    {
        if (attivitaId is null) mappa.Remove(chiave);
        else mappa[chiave] = attivitaId.Value;
    }

    private async Task CopiaPrecedente()
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Copiare la settimana precedente su questa? Le attività già inserite verranno sostituite."))
            return;
        try
        {
            await Svc.CopiaSettimanaPrecedenteAsync(inizio);
            mappa = await Svc.GetSettimanaAsync(inizio);
            await MostraMessaggio("Settimana copiata ✓");
        }
        catch (ErroreSupabase ex)
        {
            await MostraMessaggio(ex.Message, true);
        }
    }

    private async Task MostraMessaggio(string testo, bool errore = false)
    {
        messaggio = testo;
        messaggioErrore = errore;
        var id = ++messaggioId;
        StateHasChanged();
        await Task.Delay(errore ? 4000 : 1500);
        if (id == messaggioId) messaggio = null;
    }
}
