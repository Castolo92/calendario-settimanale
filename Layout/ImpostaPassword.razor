@inject Sessione Sessione

<div class="accesso">
    <div class="card">
        <div class="accesso-icona">🔒</div>
        <h1>Scegli la password</h1>
        <p class="nota">Per <b>@Sessione.Email</b>. La userai per accedere dagli altri dispositivi.</p>

        <form @onsubmit="Salva" class="accesso-form">
            <label class="campo">
                <span>Nuova password</span>
                <input class="input" type="password" autocomplete="new-password" minlength="6"
                       @bind="password" @bind:event="oninput" required />
            </label>
            <label class="campo">
                <span>Ripeti la password</span>
                <input class="input" type="password" autocomplete="new-password" minlength="6"
                       @bind="conferma" @bind:event="oninput" required />
            </label>
            @if (errore is not null)
            {
                <div class="errore">@errore</div>
            }
            <button type="submit" class="btn btn-primario" disabled="@inCorso">
                @(inCorso ? "Salvataggio…" : "Salva password")
            </button>
        </form>
    </div>
</div>

@code {
    private string password = "";
    private string conferma = "";
    private string? errore;
    private bool inCorso;

    private async Task Salva()
    {
        errore = null;
        if (password.Length < 6)
        {
            errore = "Usa almeno 6 caratteri.";
            return;
        }
        if (password != conferma)
        {
            errore = "Le due password non coincidono.";
            return;
        }

        inCorso = true;
        try
        {
            errore = await Sessione.ImpostaPasswordAsync(password);
        }
        catch (HttpRequestException)
        {
            errore = "Connessione non riuscita. Controlla internet e riprova.";
        }
        finally
        {
            inCorso = false;
        }
    }
}
